#cloud-config
packages:
  - awscli
  - jq
write_files:
  - path: /etc/example/app.conf
    owner: root:root
    permissions: "0644"
    content: |
      listen = :8080
  - path: /etc/example/small.txt
    owner: root:root
    permissions: "0644"
    content: |
      small content
  - path: /etc/example/tls.b64
    owner: root:app
    permissions: "0640"
    encoding: b64
    content: aGVsbG8K
  - path: /etc/systemd/system/app.service
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      ExecStart=/usr/local/bin/app
  - path: /etc/systemd/system/app.service.d/20-bootstrap-secrets.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Requires=bootstrap-secrets.service
      After=bootstrap-secrets.service
  - path: /etc/systemd/system/bootstrap-ready.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Tell the Auto Scaling group this instance is ready
      Wants=bootstrap-secrets.service app.service
      After=network-online.target bootstrap-secrets.service app.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/lib/bootstrap/ready.sh

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/bootstrap-secrets.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Load boot-time secrets from SSM Parameter Store
      Wants=network-online.target
      After=network-online.target
      Before=app.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/lib/bootstrap/secrets.sh

      [Install]
      WantedBy=multi-user.target
  - path: /usr/local/lib/bootstrap/ready.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      # Generated by github.com/truvity/asg/bootstrap; run by bootstrap-ready.service on every boot.
      set -e
      imds() {
        local t
        t="$(curl -fsS --connect-timeout 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)" || return 1
        curl -fsS --connect-timeout 5 -H "X-aws-ec2-metadata-token: $t" "http://169.254.169.254/latest/meta-data/$1"
      }
      bs_die() {
        echo "bootstrap: $1" >&2
        exit 1
      }
      export -f imds bs_die
      bs_abort() {
        echo "bootstrap: $1" >&2
        if ! aws autoscaling complete-lifecycle-action --region "$(imds placement/region)" \
          --auto-scaling-group-name 'example-asg' --lifecycle-hook-name 'example-hook' \
          --lifecycle-action-result ABANDON --instance-id "$(imds instance-id)" >/dev/null 2>&1; then
          aws autoscaling set-instance-health --region "$(imds placement/region)" \
            --instance-id "$(imds instance-id)" --health-status Unhealthy >/dev/null 2>&1 || true
        fi
        exit 1
      }
      systemctl is-active --quiet 'app.service' || bs_abort 'app.service is not active'
      for i in 1 2 3; do
        if out="$(aws autoscaling complete-lifecycle-action --region "$(imds placement/region)" \
          --auto-scaling-group-name 'example-asg' --lifecycle-hook-name 'example-hook' \
          --lifecycle-action-result CONTINUE --instance-id "$(imds instance-id)" 2>&1)"; then
          exit 0
        fi
        echo "bootstrap: CONTINUE attempt $i: $out" >&2
        sleep $((i * 3))
      done
      echo "bootstrap: no CONTINUE sent; if an action was pending, the hook's DefaultResult applies" >&2
      exit 0
  - path: /usr/local/lib/bootstrap/secrets.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      # Generated by github.com/truvity/asg/bootstrap; run by bootstrap-secrets.service on every boot.
      set -e
      imds() {
        local t
        t="$(curl -fsS --connect-timeout 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)" || return 1
        curl -fsS --connect-timeout 5 -H "X-aws-ec2-metadata-token: $t" "http://169.254.169.254/latest/meta-data/$1"
      }
      bs_die() {
        echo "bootstrap: $1" >&2
        exit 1
      }
      export -f imds bs_die
      bs_abort() {
        echo "bootstrap: $1" >&2
        if ! aws autoscaling complete-lifecycle-action --region "$(imds placement/region)" \
          --auto-scaling-group-name 'example-asg' --lifecycle-hook-name 'example-hook' \
          --lifecycle-action-result ABANDON --instance-id "$(imds instance-id)" >/dev/null 2>&1; then
          aws autoscaling set-instance-health --region "$(imds placement/region)" \
            --instance-id "$(imds instance-id)" --health-status Unhealthy >/dev/null 2>&1 || true
        fi
        exit 1
      }
      bash -e <<'BOOTSTRAP_EOF_0' || bs_abort 'secret /example/app/token failed'
      param='/example/app/token' dest='/run/app/token.env'
      umask 077
      region="$(imds placement/region)" || bs_die "no region from the instance metadata"
      install -d -m 0700 "$(dirname "$dest")" || bs_die "cannot create the directory of $dest"
      tmp="$(mktemp "$(dirname "$dest")/.XXXXXX")" || bs_die "mktemp failed"
      trap 'rm -f "$tmp"' EXIT
      v=""
      for i in 1 2 3 4 5; do
        if v="$(aws ssm get-parameter --region "$region" --name "$param" --with-decryption --query Parameter.Value --output text)" && [ -n "$v" ]; then
          break
        fi
        v=""
        sleep $((i * 3))
      done
      [ -n "$v" ] || bs_die "cannot read $param"
      v=${v//\\/\\\\}
      v=${v//\"/\\\"}
      printf 'APP_TOKEN="%s"\n' "$v" > "$tmp"
      v=""
      chmod 0600 "$tmp"
      chown 'app' "$tmp"
      mv -f "$tmp" "$dest"
      BOOTSTRAP_EOF_0
bootcmd:
  - set -e
  - - bash
    - -ec
    - |
      # every boot
      echo boot
runcmd:
  - set -e
  - - bash
    - -ec
    - |
      # fetch objects
      imds() {
        local t
        t="$(curl -fsS --connect-timeout 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)" || return 1
        curl -fsS --connect-timeout 5 -H "X-aws-ec2-metadata-token: $t" "http://169.254.169.254/latest/meta-data/$1"
      }
      bs_die() {
        echo "bootstrap: $1" >&2
        aws autoscaling complete-lifecycle-action --region "$(imds placement/region)" \
          --auto-scaling-group-name 'example-asg' --lifecycle-hook-name 'example-hook' \
          --lifecycle-action-result ABANDON --instance-id "$(imds instance-id)" >/dev/null 2>&1 || true
        exit 1
      }
      bucket='example-config'
      region="$(imds placement/region)" || bs_die "no region from the instance metadata"
      bs_fetch() {
        local key="$1" sum="$2" dest="$3" mode="$4" owner="$5" tmp i
        tmp="$(mktemp)" || return 1
        for i in 1 2 3 4 5; do
          if aws s3 cp --only-show-errors --region "$region" "s3://$bucket/$key" "$tmp" \
            && printf '%s  %s\n' "$sum" "$tmp" | sha256sum -c - >/dev/null 2>&1; then
            install -D -m "$mode" "$tmp" "$dest" && chown "$owner" "$dest" && rm -f "$tmp" && return 0
            break
          fi
          sleep 3
        done
        rm -f "$tmp"
        return 1
      }
      bs_fetch 'appliance/config/d371a84e9a4281c4c3d1233521c37f33585519106207ad7ca8e2023ce8207e4b.json' 'd371a84e9a4281c4c3d1233521c37f33585519106207ad7ca8e2023ce8207e4b' '/etc/example/big.json' 0644 'root:root' || bs_die 'cannot fetch /etc/example/big.json'
  - - bash
    - -ec
    - |
      # binary app
      imds() {
        local t
        t="$(curl -fsS --connect-timeout 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)" || return 1
        curl -fsS --connect-timeout 5 -H "X-aws-ec2-metadata-token: $t" "http://169.254.169.254/latest/meta-data/$1"
      }
      bs_die() {
        echo "bootstrap: $1" >&2
        aws autoscaling complete-lifecycle-action --region "$(imds placement/region)" \
          --auto-scaling-group-name 'example-asg' --lifecycle-hook-name 'example-hook' \
          --lifecycle-action-result ABANDON --instance-id "$(imds instance-id)" >/dev/null 2>&1 || true
        exit 1
      }
      case "$(uname -m)" in
        x86_64 | amd64) arch=amd64 ;;
        aarch64 | arm64) arch=arm64 ;;
        *) bs_die "unsupported architecture $(uname -m)" ;;
      esac
      case "$arch" in
        amd64) url='https://example.com/app-amd64' sum='abababababababababababababababababababababababababababababababab' ;;
        arm64) url='https://example.com/app-arm64' sum='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' ;;
        *) bs_die 'no build of app for this architecture' ;;
      esac
      dest='/usr/local/bin/app' mode=0755
      tmp="$(mktemp)" || bs_die "mktemp failed"
      trap 'rm -f "$tmp"' EXIT
      ok=0
      for i in 1 2 3 4 5; do
        if curl -fsSL --connect-timeout 10 --max-time 300 -o "$tmp" "$url" \
          && printf '%s  %s\n' "$sum" "$tmp" | sha256sum -c - >/dev/null 2>&1; then
          ok=1
          break
        fi
        echo "bootstrap: download of $url failed or did not match its sha256 (attempt $i)" >&2
        sleep 3
      done
      [ "$ok" = 1 ] || bs_die "giving up on $url"
      install -D -m "$mode" "$tmp" "$dest" || bs_die "cannot install $dest"
  - - bash
    - -ec
    - |
      # artifact /opt/tool/run.sh
      imds() {
        local t
        t="$(curl -fsS --connect-timeout 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)" || return 1
        curl -fsS --connect-timeout 5 -H "X-aws-ec2-metadata-token: $t" "http://169.254.169.254/latest/meta-data/$1"
      }
      bs_die() {
        echo "bootstrap: $1" >&2
        aws autoscaling complete-lifecycle-action --region "$(imds placement/region)" \
          --auto-scaling-group-name 'example-asg' --lifecycle-hook-name 'example-hook' \
          --lifecycle-action-result ABANDON --instance-id "$(imds instance-id)" >/dev/null 2>&1 || true
        exit 1
      }
      url='https://example.com/tool.sh' sum='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' dest='/opt/tool/run.sh' mode=0755
      tmp="$(mktemp)" || bs_die "mktemp failed"
      trap 'rm -f "$tmp"' EXIT
      ok=0
      for i in 1 2 3 4 5; do
        if curl -fsSL --connect-timeout 10 --max-time 300 -o "$tmp" "$url" \
          && printf '%s  %s\n' "$sum" "$tmp" | sha256sum -c - >/dev/null 2>&1; then
          ok=1
          break
        fi
        echo "bootstrap: download of $url failed or did not match its sha256 (attempt $i)" >&2
        sleep 3
      done
      [ "$ok" = 1 ] || bs_die "giving up on $url"
      install -D -m "$mode" "$tmp" "$dest" || bs_die "cannot install $dest"
      "$dest" || bs_die "$dest failed"
  - - bash
    - -ec
    - |
      # systemd daemon-reload
      systemctl daemon-reload
  - - bash
    - -ec
    - |
      # load boot-time secrets
      systemctl enable --now bootstrap-secrets.service
  - - bash
    - -ec
    - |
      # greet
      echo hello
  - - bash
    - -ec
    - |
      # systemd units
      systemctl enable --now 'app.service'
  - - bash
    - -ec
    - |
      # report ready
      systemctl enable --now bootstrap-ready.service
