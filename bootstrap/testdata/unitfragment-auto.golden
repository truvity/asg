#cloud-config
write_files:
  - path: /etc/systemd/system/bootstrap-secrets.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Load boot-time secrets from SSM Parameter Store
      Wants=network-online.target
      After=network-online.target
      Before=conn.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/lib/bootstrap/secrets.sh

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/conn.service
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      ExecStart=/usr/local/bin/conn
  - path: /etc/systemd/system/conn.service.d/20-bootstrap-secrets.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Requires=bootstrap-secrets.service
      After=bootstrap-secrets.service
  - path: /usr/local/lib/bootstrap/secrets.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      # Generated by aws-structure pkg/bootstrap; run by bootstrap-secrets.service on every boot.
      set -e
      imds() {
        local t
        t="$(curl -fsS --connect-timeout 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)" || return 1
        curl -fsS --connect-timeout 5 -H "X-aws-ec2-metadata-token: $t" "http://169.254.169.254/latest/meta-data/$1"
      }
      bs_die() {
        echo "bootstrap: $1" >&2
        exit 1
      }
      export -f imds bs_die
      bs_abort() {
        echo "bootstrap: $1" >&2
        exit 1
      }
      bash -e <<'BOOTSTRAP_EOF_0' || bs_abort 'conn load token failed'
      umask 077
      true
      BOOTSTRAP_EOF_0
      systemctl start --no-block 'conn.service'
runcmd:
  - set -e
  - - bash
    - -ec
    - |
      # conn install
      install_it() { true; }
      install_it
  - - bash
    - -ec
    - |
      # systemd daemon-reload
      systemctl daemon-reload
  - - bash
    - -ec
    - |
      # load boot-time secrets
      systemctl enable --now bootstrap-secrets.service
  - - bash
    - -ec
    - |
      # conn start
      systemctl daemon-reload
      systemctl start conn
