{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:@PARTITION@:ssm:eu-west-1:@ACCOUNT@:parameter/a/a",
        "arn:@PARTITION@:ssm:eu-west-1:@ACCOUNT@:parameter/z/b"
      ]
    },
    {
      "Sid": "ReadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:@PARTITION@:s3:::b/p/1.sh",
        "arn:@PARTITION@:s3:::b/p/2.sh"
      ]
    },
    {
      "Sid": "OwnGroup",
      "Effect": "Allow",
      "Action": [
        "autoscaling:CompleteLifecycleAction",
        "autoscaling:SetInstanceHealth"
      ],
      "Resource": [
        "arn:@PARTITION@:autoscaling:eu-west-1:@ACCOUNT@:autoScalingGroup:*:autoScalingGroupName/g"
      ]
    },
    {
      "Sid": "Extra",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:@PARTITION@:kms:eu-west-1:@ACCOUNT@:key/k"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "ssm.eu-west-1.amazonaws.com"
          ]
        }
      }
    }
  ]
}
